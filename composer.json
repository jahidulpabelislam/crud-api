{
    "name": "jpi/crud-api",
    "description": "CRUD API Framework",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Jahidul Pabel Islam",
            "email": "me@jahidulpabelislam.com"
        }
    ],
    "keywords": [
        "crud",
        "api",
        "entity",
        "model"
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "jpi/http": "^1.0",
        "jpi/orm": "^2.1",
        "jpi/utils": "^1.0"
    },
    "require-dev": {
        "jpi/codestyles": "^1.0.1",
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "beta",
    "autoload": {
        "psr-4": {
            "JPI\\CRUD\\API\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JPI\\CRUD\\API\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/jahidulpabelislam/http.git"
        }
    ]
}
